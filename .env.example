# ─── Обязательно ─────────────────────────────────────────────────────────────
# PostgreSQL. На Vercel — пулинговый адрес (у Neon хост с «-pooler»).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/leados?schema=public"
# Прямой (не пулинговый) адрес той же базы — для миграций. Локально и на VPS можно не задавать.
# DIRECT_URL=
# Вход в интерфейс (в production обязательно, пароль не короче 12 символов)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Публичный адрес: ссылки в уведомлениях, API и закладках. Пример: https://leads.example.ru
APP_URL=http://localhost:3000

# ─── Интеграции ─────────────────────────────────────────────────────────────
# Токен для /api/* (Telegram-воркер). Минимум 16 символов: openssl rand -hex 32
API_TOKEN=
# Секрет для ежедневного cron Vercel (/api/cron/daily). Минимум 16 символов: openssl rand -hex 32
CRON_SECRET=

# AI (RouterAI): ключ из https://routerai.ru → Настройки → API-ключи
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
# Модели по цене (₽ за 1M токенов вход/выход): deepseek-v4-flash ≈5/10 — оценка, контакты, дайджест;
# deepseek-v4-pro ≈65/129 — тексты клиентам (≈1 ₽ за оффер). Claude Opus 5 ≈550/2700 — в сотню раз дороже, не ставь без нужды.
# Пусто — значения по умолчанию ниже.
# AI_MODEL=deepseek/deepseek-v4-flash
# AI_WRITER_MODEL=deepseek/deepseek-v4-pro
# Недельный бюджет на AI в рублях: сверх него AI не вызывается (проверка сайтов работает). Не задан — 80, 0 — без ограничения.
AI_WEEKLY_BUDGET_RUB=80
# Потолок рассуждений модели: low | medium | high. Рассуждения оплачиваются как ответ — low дешевле всего.
# AI_REASONING_MAX=low
# Автоматический поиск контактов в интернете для каждой найденной компании (веб-поиск ≈1,5 ₽ за компанию).
# По умолчанию выключен — только кнопкой в карточке.
AI_FIND_CONTACTS=false
# Модель для веб-поиска контактов (по умолчанию — AI_MODEL)
# AI_SEARCH_MODEL=
# Опционально: ограничить маршрутизацию провайдерами/страной обработки.
# ROUTERAI_PROVIDER_COUNTRY=ru
# ROUTERAI_PROVIDER_ORDER=deepseek,yandex
# ROUTERAI_ALLOW_FALLBACKS=true
# Опционально: своя цена в рублях за 1M токенов. Без неё стоимость берётся из каталога моделей RouterAI.
# AI_PRICE_INPUT_RUB_PER_1M=
# AI_PRICE_OUTPUT_RUB_PER_1M=
# Оценивать новые лиды автоматически
AI_AUTO_SCORE=true
# Выполнять AI-задачи сразу после запросов (по умолчанию включено на Vercel; на VPS — фоновый воркер)
# AI_INLINE_JOBS=true
AI_WORKER_CONCURRENCY=2

# Уведомления себе в Telegram: токен бота от @BotFather. Чат подключается на странице «Настройки»
TELEGRAM_BOT_TOKEN=
# или сразу id чата
# TELEGRAM_CHAT_ID=

# ─── Поведение ──────────────────────────────────────────────────────────────
# Часовой пояс для дат, месяцев и утренней сводки
APP_TIMEZONE=Europe/Moscow
# Час утренней сводки и дайджеста (в APP_TIMEZONE). На Vercel время задаётся расписанием в vercel.json
DIGEST_HOUR=8
# Через сколько дней без движения лид в «Контакт»/«Переговоры» считается зависшим
STALE_DAYS=5
# Размер пула подключений к базе на процесс (по умолчанию 3 на Vercel, 10 на сервере)
# DB_POOL_MAX=

# ─── Только docker compose (VPS) ────────────────────────────────────────────
POSTGRES_PASSWORD=
# Telegram-воркер чтения каналов (docker compose --profile telegram), см. docs/INSTRUCTIONS.md § 4
TG_API_ID=
TG_API_HASH=
TG_SESSION=
