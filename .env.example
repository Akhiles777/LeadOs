# ─── Обязательно ─────────────────────────────────────────────────────────────
# PostgreSQL. На Vercel — пулинговый адрес (у Neon хост с «-pooler»).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/leados?schema=public"
# Прямой (не пулинговый) адрес той же базы — для миграций. Локально и на VPS можно не задавать.
# DIRECT_URL=
# Вход в интерфейс (в production обязательно, пароль не короче 12 символов)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Публичный адрес: ссылки в уведомлениях, API и закладках. Пример: https://leads.example.ru
APP_URL=http://localhost:3000

# ─── Интеграции ─────────────────────────────────────────────────────────────
# Токен для /api/* (Telegram-воркер). Минимум 16 символов: openssl rand -hex 32
API_TOKEN=
# Секрет для ежедневного cron Vercel (/api/cron/daily). Минимум 16 символов: openssl rand -hex 32
CRON_SECRET=

# AI (Claude API): ключ из https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# Оценивать новые лиды автоматически
AI_AUTO_SCORE=true
# Выполнять AI-задачи сразу после запросов (по умолчанию включено на Vercel; на VPS — фоновый воркер)
# AI_INLINE_JOBS=true
AI_WORKER_CONCURRENCY=2

# Уведомления себе в Telegram: токен бота от @BotFather. Чат подключается на странице «Настройки»
TELEGRAM_BOT_TOKEN=
# или сразу id чата
# TELEGRAM_CHAT_ID=

# ─── Поведение ──────────────────────────────────────────────────────────────
# Часовой пояс для дат, месяцев и утренней сводки
APP_TIMEZONE=Europe/Moscow
# Час утренней сводки и дайджеста (в APP_TIMEZONE). На Vercel время задаётся расписанием в vercel.json
DIGEST_HOUR=8
# Через сколько дней без движения лид в «Контакт»/«Переговоры» считается зависшим
STALE_DAYS=5
# Размер пула подключений к базе на процесс (по умолчанию 3 на Vercel, 10 на сервере)
# DB_POOL_MAX=

# ─── Только docker compose (VPS) ────────────────────────────────────────────
POSTGRES_PASSWORD=
# Telegram-воркер чтения каналов (docker compose --profile telegram), см. docs/INSTRUCTIONS.md § 4
TG_API_ID=
TG_API_HASH=
TG_SESSION=
